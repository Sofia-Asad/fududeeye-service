# Copy to .env and fill in values before running.

# Django
DJANGO_SECRET_KEY=django-insecure-replace-with-50-random-chars
DJANGO_SETTINGS_MODULE=config.settings.dev

# Dev only (SQLite is used by default in dev — no DB vars needed)

# Production PostgreSQL (set DJANGO_SETTINGS_MODULE=config.settings.prod)
# POSTGRES_DB=fududeeye
# POSTGRES_USER=fududeeye_user
# POSTGRES_PASSWORD=strong-password-here
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Production hosts / CORS (comma-separated)
# ALLOWED_HOSTS=crm.fududeeye.com
# CORS_ALLOWED_ORIGINS=https://crm.fududeeye.com
# CSRF_TRUSTED_ORIGINS=https://crm.fududeeye.com

# Password reset links point here (the CRM app) — change for production.
FRONTEND_URL=http://localhost:5173/crm

# Password reset link lifetime, in seconds (default: 3600 = 1 hour)
PASSWORD_RESET_TIMEOUT=3600

# Password reset rate limits, per IP (django-rest-framework throttle format).
# Request (sends an email) stays tight; confirm (setting the new password) is
# looser since a legitimate user may retype a mistyped password a few times.
PASSWORD_RESET_THROTTLE_RATE=5/hour
PASSWORD_RESET_CONFIRM_THROTTLE_RATE=20/hour

# Email (password reset) — leave EMAIL_HOST_USER blank to print reset emails
# to the runserver console instead of sending them; fill both in to send for
# real over SMTP.
#
# Gmail App Password setup:
#   1. Turn on 2-Step Verification on the Gmail account: https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords and create an App
#      Password for "Mail" (a 16-character code, unrelated to your normal
#      Gmail password — the Gmail account password will NOT work here and
#      Google will reject it).
#   3. Put that 16-character code in EMAIL_HOST_PASSWORD below (spaces optional).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Fududeeye Brokerage <no-reply@fududeeye.com>
